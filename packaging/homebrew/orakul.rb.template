# Каст Homebrew для orakul. ФАЙЛ-ШАБЛОН: значения в фигурных скобках
# подставляет scripts/refresh-cask.sh по собранным образам.
#
# Готовый файл живёт не здесь, а в отдельном репозитории-кране
# (theasder/homebrew-orakul): Homebrew ищет касты в репозитории с именем
# homebrew-<кран>, и положить его рядом с исходниками нельзя.
cask "orakul" do
  arch arm: "AppleSilicon", intel: "Intel"

  version "{{VERSION}}"
  sha256 arm:   "{{SHA_ARM}}",
         intel: "{{SHA_INTEL}}"

  url "https://github.com/theasder/orakul/releases/download/v#{version}/orakul-#{arch}.dmg",
      verified: "github.com/theasder/orakul/"
  name "orakul"
  desc "Meeting assistant that answers with a quote from your own calls"
  homepage "https://github.com/theasder/orakul"

  depends_on macos: ">= :{{MACOS}}"

  app "orakul.app"

  zap trash: [
    "~/Library/Application Support/MeetGPT",
    "~/Library/Preferences/ai.orakul.desktop.plist",
    "~/Library/Caches/ai.orakul.desktop",
  ]
end
